# .env - konfigurasi lingkungan untuk development
# Penjelasan singkat variabel:
# PORT        : port aplikasi Express
# JWT_SECRET  : rahasia untuk menandatangani JWT (jangan gunakan nilai ini di production)
# DB_NAME     : nama database MySQL
# DB_USER     : username untuk koneksi DB
# DB_PASS     : password untuk koneksi DB (kosong berarti tidak ada password)
# DB_HOST     : host MySQL (127.0.0.1 untuk localhost)

PORT=3000
JWT_SECRET=rahasia_super_aman_123
DB_NAME=employees_db
DB_USER=root
DB_PASS=
DB_HOST=127.0.0.1