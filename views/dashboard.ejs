<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container-fluid px-5 mt-5">

    <!-- HEADER -->
    <div class="card bg-white bg-opacity-75 shadow-lg border-0 rounded-4 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center p-4">

            <div>
                <h1 class="fw-bold text-primary mb-1">
                    Employee Management System
                </h1>
                <p class="text-muted fs-4 mb-0">
                    Human Resource Dashboard
                </p>
            </div>

            <div class="text-end">
                <div class="fs-4 fw-semibold">
                    <i class="bi bi-person-circle"></i> <%= user.username %>
                </div>
                <span class="badge bg-primary fs-5 text-capitalize">
                    <%= user.role %>
                </span>
                <br>
                <a href="/auth/logout"
                   class="btn btn-outline-primary btn-lg mt-3">
                    Logout
                </a>
            </div>

        </div>
    </div>

    <% if (user.role === 'manager') { %>
        <a href="/add"
           class="btn btn-primary btn-lg mb-4 px-4 py-3 fs-4 shadow">
            <i class="bi bi-person-plus-fill"></i> Add Employee
        </a>
    <% } %>

    <!-- TABLE -->
    <div class="card bg-white bg-opacity-75 shadow-lg border-0 rounded-4">
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary fs-4">
                    <tr>
                        <th>Full Name</th>
                        <th>Division</th>
                        <th>Leave Balance</th>
                        <th>Notes</th>
                        <th>Updated</th>
                        <th width="300">Action</th>
                    </tr>
                </thead>

                <tbody class="fs-4">
                    <% employees.forEach(employee => { %>
                        <tr class="transition <%= employee.leave_balance <= employee.min_leave ? 'table-warning' : '' %>">

                            <td class="fw-bold text-primary">
                                <%= employee.full_name %>
                            </td>

                            <td>
                                <span class="badge bg-info fs-6">
                                    <%= employee.division %>
                                </span>
                            </td>

                            <td>
                                <%= employee.leave_balance %>
                                <small class="text-muted fs-6">
                                    (Min: <%= employee.min_leave %>)
                                </small>
                            </td>

                            <td><%= employee.notes || '-' %></td>

                            <td>
                                <small class="text-muted">
                                <% if (employee.updated_at) { 
                                    const d = new Date(employee.updated_at);
                                    const opt = {
                                        weekday:'long',
                                        year:'numeric',
                                        month:'long',
                                        day:'numeric',
                                        hour:'2-digit',
                                        minute:'2-digit'
                                    };
                                %>
                                    <%= d.toLocaleDateString('id-ID', opt) %>
                                <% } else { %>
                                    System
                                <% } %>
                                </small>
                            </td>

                            <td>
                                <a href="/edit/<%= employee.id %>"
                                   class="btn btn-outline-primary btn-lg me-2">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </a>

                                <% if (user.role === 'manager') { %>
                                    <form action="/delete/<%= employee.id %>"
                                          method="POST" class="d-inline">
                                        <button class="btn btn-outline-danger btn-lg"
                                                onclick="return confirm('Set employee as inactive?')">
                                            <i class="bi bi-person-x-fill"></i> Resign
                                        </button>
                                    </form>
                                <% } %>
                            </td>

                        </tr>
                    <% }) %>
                </tbody>

            </table>

        </div>
    </div>

</div>

</body>
</html>
