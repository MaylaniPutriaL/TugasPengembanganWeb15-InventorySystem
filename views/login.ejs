<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light d-flex align-items-center justify-content-center" style="height:100vh;">

<div class="card shadow-lg border-0" style="width:520px;">
    <div class="card-body p-5">

        <h1 class="text-center text-primary fw-bold mb-1">
            Employee System
        </h1>
        <p class="text-center text-muted fs-4 mb-5">
            Secure Login 
        </p>

        <% if (error) { %>
            <div class="alert alert-danger fs-5"><%= error %></div>
        <% } %>

        <form action="/auth/login" method="POST">

            <div class="mb-4">
                <label class="form-label fs-4">Username</label>
                <input type="text" name="username"
                       class="form-control form-control-lg fs-4" required>
            </div>

            <div class="mb-4">
                <label class="form-label fs-4">Password</label>
                <input type="password" name="password"
                       class="form-control form-control-lg fs-4" required>
            </div>

            <button class="btn btn-primary btn-lg w-100 fs-4 fw-semibold py-3">
                Login
            </button>

        </form>

    </div>
</div>

</body>
</html>
